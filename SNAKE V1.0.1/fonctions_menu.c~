void boucle_menu(int width, int height, MLV_Font* font_title){
  int i = 1;
  int mx, my;
  int b_largeur = width / 2;
  int b_hauteur = height / 4;
  int b_milieu_x = (width - b_largeur) / 2;
  int b_ecart_entre = (height - (b_hauteur * 3)) / 4;
  int by1 = b_ecart_entre;
  int by2 = by1 + b_hauteur + b_ecart_entre;
  int by3 = by2 + b_hauteur + b_ecart_entre;
  int quitterx = width - 160; 
  int quittery = height - 80; 
  int quitterw = 140;         
  int quitterh = 50;
  
  while (i==1) {

    afficher_menu(width, height, font_title);
    
    MLV_wait_mouse(&mx, &my);

    if (clic_bouton(b_milieu_x, by1, b_largeur, b_hauteur, mx, my)){
      animation_clic_bouton(b_milieu_x, by1, b_largeur, b_hauteur, "Charger Partie");
      boucle_charger(width,height,font_title);
    }
    if (clic_bouton(b_milieu_x, by2, b_largeur, b_hauteur, mx, my)){
      animation_clic_bouton(b_milieu_x, by2, b_largeur, b_hauteur, "Nouvelle Partie");
      boucle_charger(width,height,font_title);
    }
    if (clic_bouton(b_milieu_x, by3, b_largeur, b_hauteur, mx, my)){
      animation_clic_bouton(b_milieu_x, by3, b_largeur, b_hauteur, "2 Joueurs");
      boucle_charger(width,height,font_title);
    }
    if (clic_bouton(quitterx, quittery, quitterw, quitterh, mx, my)) {
      animation_clic_bouton(quitterx, quittery, quitterw, quitterh, "Quitter");
      i=0;
    }
  }
}

void boucle_charger(int width, int height, MLV_Font* font_title){
  int i = 1;
  int mx,my;
  int retourx = width - 160; 
  int retoury = height - 80; 
  int retourw = 140;
  int retourh = 50;
  int s_largeur = width / 4, s_hauteur = height / 2;
  int s_milieu_y = (height - s_hauteur) / 2;
  int s_ecart_entre = (height - (s_largeur * 3)) / 4;
  int sx1 = s_ecart_entre;
  int sx2 = sx1 + s_largeur + s_ecart_entre;
  int sx3 = sx2 + s_largeur + s_ecart_entre;
 
    
