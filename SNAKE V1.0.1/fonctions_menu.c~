    MLV_wait_mouse(&mx,&my);

    if (clic_bouton(retourx, retoury, retourw, retourh, mx, my)) {
      animation_clic_bouton(retourx, retoury, retourw, retourh, "Retour");
      i=0;
    }
    if (clic_bouton(sx1, s_milieu_y, s_largeur, s_hauteur, mx, my)) {
      animation_clic_bouton(sx1, s_milieu_y, s_largeur, s_hauteur, "Sauvegarde 1");
    }
    if (clic_bouton(sx2, s_milieu_y, s_largeur, s_hauteur, mx, my)) {
      animation_clic_bouton(sx2, s_milieu_y, s_largeur, s_hauteur, "Sauvegarde 2");
    }
    if (clic_bouton(sx3, s_milieu_y, s_largeur, s_hauteur, mx, my)) {
      animation_clic_bouton(sx3, s_milieu_y, s_largeur, s_hauteur, "Sauvegarde 3");
    }
  }
}

